{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbitscore:protocol:session:v1",
  "title": "OrbitScoreSessionProtocolV1",
  "description": "OrbitScore session protocol v1: JSON-RPC 2.0 over WebSocket (/rpc). One text frame carries one message. Design: docs/design/848-native-orbitstudio-design.md section 5. This file is the single source of truth; protocol/gen/ is generated from it (npm run protocol:generate).",
  "x-protocol-version": "1.0",
  "x-surface-vocabulary": {
    "gui": "The app's GUI calls this client-to-server method as a user operation.",
    "mcp": "The MCP relay calls this method to implement the MCP tools listed in x-mcp-tools.",
    "editor": "The editor client calls this method to keep layer 2's copy of its documents and to render language services in the editor. It is not an operation on the session.",
    "infra": "Handshake, lifecycle and server-to-client events."
  },
  "x-errors": {
    "PARSE_ERROR": -32700,
    "INVALID_REQUEST": -32600,
    "METHOD_NOT_FOUND": -32601,
    "INVALID_PARAMS": -32602,
    "INTERNAL_ERROR": -32603,
    "PROTOCOL_VERSION_MISMATCH": -32010,
    "EDITOR_ALREADY_ATTACHED": -32011,
    "NO_EDITOR_ATTACHED": -32012,
    "EDITOR_TIMEOUT": -32013,
    "DOC_NOT_FOUND": -32020,
    "DOCS_UNAVAILABLE": -32021,
    "SHUTTING_DOWN": -32030,
    "ENGINE_NOT_RUNNING": -32031
  },
  "x-methods": {
    "session.hello": {
      "direction": "server-to-client",
      "kind": "notification",
      "description": "The first message on every connection. Carries no secret.",
      "params": { "$ref": "#/$defs/HelloParams" },
      "x-surfaces": ["infra"]
    },
    "session.attach": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Must be the first request. Any other method before it closes the connection with 1008. The token is required on the TCP listener and ignored on the Unix socket.",
      "params": { "$ref": "#/$defs/AttachParams" },
      "result": { "$ref": "#/$defs/AttachResult" },
      "x-surfaces": ["infra"]
    },
    "session.evaluate": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Stateless evaluation: documentDirectory is required on every call (null = no base). All clients share one FIFO. ENGINE_NOT_RUNNING when the engine has not been started.",
      "params": { "$ref": "#/$defs/EvaluateParams" },
      "result": { "$ref": "#/$defs/EvaluateResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["evaluate_orbitscore"]
    },
    "session.getState": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/SessionState" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["evaluate_orbitscore"]
    },
    "session.getLog": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/GetLogParams" },
      "result": { "$ref": "#/$defs/GetLogResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["get_log"]
    },
    "session.registerMcp": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Registers the relay stub with an LLM client (stdio, no secret, no port).",
      "params": { "$ref": "#/$defs/RegisterMcpParams" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["register_mcp_server"]
    },
    "session.shutdown": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Stops the engine (waits for the daemon to exit) and ends the session process.",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/EmptyResult" },
      "x-surfaces": ["infra"]
    },
    "engine.start": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/StartEngineParams" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["start_engine"]
    },
    "engine.stop": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Responds only after the daemon process has exited.",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["stop_engine"]
    },
    "engine.getState": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/EngineState" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["get_engine_state"]
    },
    "engine.state": {
      "direction": "server-to-client",
      "kind": "notification",
      "params": { "$ref": "#/$defs/EngineState" },
      "x-surfaces": ["infra"]
    },
    "audio.listDevices": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/AudioDevicesResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["list_audio_devices"]
    },
    "audio.selectDevice": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/SelectDeviceParams" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["select_audio_device"]
    },
    "audio.analyze": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/AnalyzeAudioParams" },
      "result": { "$ref": "#/$defs/AnalyzeAudioResult" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["analyze_audio"]
    },
    "plugin.saveState": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/PluginTarget" },
      "result": { "$ref": "#/$defs/SavePluginStateResult" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["save_plugin_state"]
    },
    "plugin.openUi": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/OpenPluginUiParams" },
      "result": { "$ref": "#/$defs/PluginUiResult" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["open_plugin_ui"]
    },
    "plugin.closeUi": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/PluginTarget" },
      "result": { "$ref": "#/$defs/PluginUiResult" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["close_plugin_ui"]
    },
    "plugin.openUiAtCursor": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Layer 2 resolves the plugin name under the synced cursor (#939 / #940 rules). NO_EDITOR_ATTACHED without an editor client.",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/PluginUiAtCursorResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["open_plugin_ui_at_cursor"]
    },
    "plugin.list": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/ListPluginsResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["list_plugins"]
    },
    "plugin.rescan": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/RescanPluginsResult" },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["rescan_plugins"]
    },
    "editor.didOpen": {
      "direction": "client-to-server",
      "kind": "notification",
      "params": { "$ref": "#/$defs/DidOpenParams" },
      "x-surfaces": ["editor"]
    },
    "editor.didChange": {
      "direction": "client-to-server",
      "kind": "notification",
      "params": { "$ref": "#/$defs/DidChangeParams" },
      "x-surfaces": ["editor"]
    },
    "editor.didClose": {
      "direction": "client-to-server",
      "kind": "notification",
      "params": { "$ref": "#/$defs/DidCloseParams" },
      "x-surfaces": ["editor"]
    },
    "editor.didChangeSelection": {
      "direction": "client-to-server",
      "kind": "notification",
      "params": { "$ref": "#/$defs/DidChangeSelectionParams" },
      "x-surfaces": ["editor"]
    },
    "editor.didChangeActive": {
      "direction": "client-to-server",
      "kind": "notification",
      "description": "The document of the front window (key window), or null when no document window is open.",
      "params": { "$ref": "#/$defs/DidChangeActiveParams" },
      "x-surfaces": ["editor"]
    },
    "editor.complete": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/CompleteParams" },
      "result": { "$ref": "#/$defs/CompleteResult" },
      "x-surfaces": ["editor"]
    },
    "editor.getDiagnostics": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Computed by layer 2 from the synced documents (the same result the editor.diagnostics notification carries).",
      "params": { "$ref": "#/$defs/GetDiagnosticsParams" },
      "result": { "$ref": "#/$defs/GetDiagnosticsResult" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["get_diagnostics"]
    },
    "editor.getState": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Answered from layer 2's synced copy. NO_EDITOR_ATTACHED without an editor client.",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/EditorState" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["get_editor_state", "evaluate_orbitscore"]
    },
    "editor.getDocumentText": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Answered from layer 2's synced copy. NO_EDITOR_ATTACHED without an editor client.",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/DocumentText" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["get_document_text"]
    },
    "editor.diagnostics": {
      "direction": "server-to-client",
      "kind": "notification",
      "params": { "$ref": "#/$defs/EditorDiagnosticsParams" },
      "x-surfaces": ["infra"]
    },
    "editor.openFile": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Layer 2 forwards the request to the attached editor client (x-editor-request). NO_EDITOR_ATTACHED without one, EDITOR_TIMEOUT when it does not answer.",
      "params": { "$ref": "#/$defs/OpenFileParams" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-editor-request": "same",
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["open_file"]
    },
    "editor.setSelection": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/SelectionInput" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-editor-request": "same",
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["set_selection"]
    },
    "editor.runSelection": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "Layer 2 asks the editor client only for its selection (x-editor-request), resolves the subject block itself and evaluates the result. The editor client never awaits an RPC while answering (failure mode F-4).",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-editor-request": {
        "params": { "$ref": "#/$defs/EmptyParams" },
        "result": { "$ref": "#/$defs/SelectionSnapshot" }
      },
      "x-surfaces": ["gui", "mcp"],
      "x-mcp-tools": ["run_selection"]
    },
    "editor.editReplace": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/EditReplaceParams" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-editor-request": "same",
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["edit_replace"]
    },
    "editor.saveFile": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/EmptyParams" },
      "result": { "$ref": "#/$defs/CommandResult" },
      "x-editor-request": "same",
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["save_file"]
    },
    "editor.configureFlash": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/FlashConfigInput" },
      "result": { "$ref": "#/$defs/FlashConfigResult" },
      "x-editor-request": "same",
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["configure_flash"]
    },
    "docs.get": {
      "direction": "client-to-server",
      "kind": "request",
      "description": "DOC_NOT_FOUND when the page does not exist; DOCS_UNAVAILABLE for every call when the site is not present under --docs-dir (the dev site is not bundled in the app).",
      "params": { "$ref": "#/$defs/DocsGetParams" },
      "result": { "$ref": "#/$defs/DocsGetResult" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["get_user_doc", "get_dev_doc"]
    },
    "docs.search": {
      "direction": "client-to-server",
      "kind": "request",
      "params": { "$ref": "#/$defs/DocsSearchParams" },
      "result": { "$ref": "#/$defs/DocsSearchResult" },
      "x-surfaces": ["mcp"],
      "x-mcp-tools": ["search_user_docs", "search_dev_docs"]
    },
    "transport.step": {
      "direction": "server-to-client",
      "kind": "notification",
      "description": "Broadcast to every client.",
      "params": { "$ref": "#/$defs/TransportStepParams" },
      "x-surfaces": ["infra"]
    },
    "transport.state": {
      "direction": "server-to-client",
      "kind": "notification",
      "params": { "$ref": "#/$defs/TransportState" },
      "x-surfaces": ["infra"]
    },
    "log.line": {
      "direction": "server-to-client",
      "kind": "notification",
      "description": "Layer 2 classifies every line; clients never classify.",
      "params": { "$ref": "#/$defs/LogLineParams" },
      "x-surfaces": ["infra"]
    }
  },
  "$defs": {
    "EmptyParams": {
      "type": "object",
      "additionalProperties": false
    },
    "EmptyResult": {
      "type": "object",
      "additionalProperties": false
    },
    "Position": {
      "description": "0-based line and UTF-16 character offset (LSP).",
      "type": "object",
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 }
      },
      "required": ["line", "character"],
      "additionalProperties": false
    },
    "Range": {
      "description": "LSP range; end is exclusive.",
      "type": "object",
      "properties": {
        "start": { "$ref": "#/$defs/Position" },
        "end": { "$ref": "#/$defs/Position" }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "DocumentUri": {
      "description": "A document URI as the editor client knows it (file: for saved documents).",
      "type": "string",
      "minLength": 1
    },
    "ClientInfo": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "ClientCapability": {
      "type": "string",
      "enum": ["editor", "observer"]
    },
    "ProtocolVersion": {
      "description": "MAJOR.MINOR. MINOR adds only (new methods, new optional fields); MAJOR breaks.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "SuccessResult": {
      "type": "object",
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string" }
      },
      "required": ["ok"],
      "additionalProperties": false
    },
    "ErrorResult": {
      "type": "object",
      "properties": {
        "ok": { "const": false },
        "error": { "type": "string" }
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    },
    "DetailedErrorResult": {
      "type": "object",
      "properties": {
        "ok": { "const": false },
        "error": { "type": "string" },
        "code": { "type": "string" },
        "details": {}
      },
      "required": ["ok", "error"],
      "additionalProperties": false
    },
    "CommandResult": {
      "oneOf": [{ "$ref": "#/$defs/SuccessResult" }, { "$ref": "#/$defs/ErrorResult" }]
    },
    "ErrorData": {
      "description": "The data member of a JSON-RPC error object. code is a key of x-errors.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "detail": { "type": "string" }
      },
      "required": ["code"],
      "additionalProperties": true
    },
    "HelloParams": {
      "type": "object",
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "session_version": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["protocol_version", "session_version", "capabilities"],
      "additionalProperties": false
    },
    "AttachParams": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The client's protocol version. A different MAJOR is rejected with PROTOCOL_VERSION_MISMATCH."
        },
        "token": {
          "type": "string",
          "description": "Required on the TCP listener (WebView only). Secret: never log it."
        },
        "client": { "$ref": "#/$defs/ClientInfo" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/ClientCapability" },
          "uniqueItems": true
        }
      },
      "required": ["protocol_version", "client", "capabilities"],
      "additionalProperties": false
    },
    "AttachResult": {
      "type": "object",
      "properties": {
        "clientId": { "type": "string", "minLength": 1 }
      },
      "required": ["clientId"],
      "additionalProperties": false
    },
    "EvaluationSource": {
      "type": "string",
      "enum": ["human", "agent"]
    },
    "EvaluateTarget": {
      "description": "Which document and range this evaluation came from. v1 uses it for attribution only; code stays the text that is evaluated.",
      "type": "object",
      "properties": {
        "uri": { "$ref": "#/$defs/DocumentUri" },
        "version": {
          "type": "integer",
          "description": "The editor.didChange version the range refers to. Required with range."
        },
        "range": { "$ref": "#/$defs/Range" }
      },
      "required": ["uri"],
      "dependentRequired": { "range": ["version"] },
      "additionalProperties": false
    },
    "EvaluateFrame": {
      "description": "Extra attributes for the session log frame (.orbslog).",
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "EvaluateParams": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "documentDirectory": {
          "type": ["string", "null"],
          "description": "Required on every call. null = no base (clears the previous base)."
        },
        "source": { "$ref": "#/$defs/EvaluationSource" },
        "target": { "$ref": "#/$defs/EvaluateTarget" },
        "frame": { "$ref": "#/$defs/EvaluateFrame" }
      },
      "required": ["code", "documentDirectory", "source"],
      "additionalProperties": false
    },
    "EvaluateDiagnostic": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["parse", "runtime"] },
        "message": { "type": "string" }
      },
      "required": ["kind", "message"],
      "additionalProperties": false
    },
    "EvalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "EvaluateResult": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "true only when diagnostics is empty."
        },
        "evalId": { "$ref": "#/$defs/EvalId" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvaluateDiagnostic" }
        },
        "documentDirectory": {
          "type": ["string", "null"],
          "description": "The value that was actually used."
        }
      },
      "required": ["ok", "evalId", "diagnostics", "documentDirectory"],
      "additionalProperties": false
    },
    "SyncedDocument": {
      "type": "object",
      "properties": {
        "uri": { "$ref": "#/$defs/DocumentUri" },
        "version": { "type": "integer" }
      },
      "required": ["uri", "version"],
      "additionalProperties": false
    },
    "SessionState": {
      "type": "object",
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "engine": { "$ref": "#/$defs/EngineState" },
        "transport": { "$ref": "#/$defs/TransportState" },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/SyncedDocument" } },
        "activeUri": { "type": ["string", "null"] },
        "workspaceRoot": {
          "type": ["string", "null"],
          "description": "--workspace-root, or null when it was not given."
        },
        "editorAttached": { "type": "boolean" }
      },
      "required": [
        "protocolVersion",
        "engine",
        "transport",
        "documents",
        "activeUri",
        "workspaceRoot",
        "editorAttached"
      ],
      "additionalProperties": false
    },
    "GetLogParams": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "number",
          "description": "Trailing lines to return (default 50, capped at the ring capacity). Fractions are truncated and values below 1 return 1 line, as the v1 MCP get_log did."
        }
      },
      "additionalProperties": false
    },
    "GetLogResult": {
      "type": "object",
      "properties": {
        "lines": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["lines"],
      "additionalProperties": false
    },
    "RegisterMcpParams": {
      "type": "object",
      "properties": {
        "scope": { "type": "string", "description": "user (default) or project." },
        "port": {
          "type": "integer",
          "description": "Accepted for the v1 MCP tool shape and not used (the relay finds the session by its socket)."
        }
      },
      "required": ["scope"],
      "additionalProperties": false
    },
    "StartEngineParams": {
      "type": "object",
      "properties": {
        "captureWav": { "type": "string" },
        "audioDevice": { "type": "string" },
        "debug": { "type": "boolean" },
        "hostBundleId": {
          "type": "string",
          "description": "Defaults to the session's --host-bundle-id (the app's own bundle id)."
        }
      },
      "additionalProperties": false
    },
    "EngineState": {
      "type": "object",
      "properties": {
        "running": { "type": "boolean" },
        "liveCoding": { "type": "boolean" },
        "output": { "type": "object" },
        "callback": { "type": "object" },
        "statusError": { "type": "string" }
      },
      "required": ["running", "liveCoding"],
      "additionalProperties": false
    },
    "SelectDeviceParams": {
      "type": "object",
      "properties": {
        "device": { "type": "string", "description": "Empty = the system default." }
      },
      "required": ["device"],
      "additionalProperties": false
    },
