// #611 §9 golden: send(aux, 0.3) — 0.3 is now dB (B2), not linear (was pre-#611).
//
// 🔴 バス名は一意にする（output_line_sum.orbs の注記と同じ理由）。

var global = init GLOBAL
global.tempo(120)
global.beat(4 by 4)
global.audioPath("../../../test-assets/audio")
global.aux("o0rev611")
aux("o0rev611").output()
global.start()

var dry = init global.seq
dry.beat(4 by 4).length(1)
dry.audio("kick.wav").chop(1)
dry.output()
dry.play(1, 1, 1, 1)

var kick = init global.seq
kick.beat(4 by 4).length(1)
kick.audio("kick.wav").chop(1)
kick.send("o0rev611", 0.3).output()
kick.play(1, 1, 1, 1)

LOOP(dry)
