// #883 X2-B: explicit "master" reference for the omitted-destination oracle.

var global = init GLOBAL
global.tempo(120)
global.beat(4 by 4)
global.audioPath("../../../test-assets/audio")
global.start()

var kick = init global.seq
kick.beat(4 by 4).length(1)
kick.audio("kick.wav").chop(1)
kick.output("master")
kick.play(1, 1, 1, 1)

LOOP(kick)
